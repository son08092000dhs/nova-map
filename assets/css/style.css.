* {
  box-sizing: border-box;
}

:root {
  color-scheme: dark;
  --bg: #0b1628;
  --panel: #14243b;
  --line: #29415f;
  --text: #edf4ff;
  --muted: #a9bad0;
  --accent: #4da3ff;
}

html, body {
  margin: 0;
  min-height: 100%;
  background: var(--bg);
  color: var(--text);
  font-family: system-ui, sans-serif;
}

.topbar {
  min-height: 66px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 18px;
  background: #10233f;
  border-bottom: 1px solid var(--line);
}

.brand {
  font-size: 21px;
  font-weight: 800;
  letter-spacing: .08em;
}

.brand span {
  color: #69b4ff;
  font-size: 12px;
}

.subtitle {
  color: var(--muted);
  font-size: 11px;
}

.layout {
  display: grid;
  grid-template-columns: 330px minmax(0, 1fr);
  min-height: calc(100vh - 66px);
}

.sidebar {
  padding: 14px;
  overflow: auto;
  border-right: 1px solid var(--line);
}

.panel {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 13px;
  margin-bottom: 12px;
}

h2 {
  font-size: 14px;
  margin: 0 0 11px;
}

input {
  width: 100%;
  min-width: 0;
  border: 1px solid #395473;
  border-radius: 8px;
  padding: 11px;
  color: var(--text);
  background: #0c1a2d;
  font: inherit;
}

button {
  border: 1px solid #395473;
  border-radius: 8px;
  padding: 10px 11px;
  color: var(--text);
  background: #203957;
  font: inherit;
  cursor: pointer;
}

button.primary {
  background: #1769b5;
  border-color: #368bd8;
}

button.danger {
  background: #552d3a;
  border-color: #8d4b5e;
}

.search-row {
  display: flex;
  gap: 7px;
}

.button-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 7px;
}

.hint {
  color: var(--muted);
  font-size: 12px;
  line-height: 1.45;
}

.file-label {
  display: block;
  margin-top: 10px;
  color: var(--muted);
  font-size: 12px;
}

.assistant-output {
  margin-top: 9px;
  padding: 10px;
  border-radius: 8px;
  background: #0c1a2d;
  border: 1px solid var(--line);
  font-size: 12px;
  min-height: 48px;
}

.metrics div {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 7px 0;
  border-top: 1px solid #263b56;
  font-size: 12px;
}

.metrics span {
  color: var(--muted);
}

.metrics strong {
  text-align: right;
}

.map-wrap {
  position: relative;
  min-height: 520px;
}

#map {
  width: 100%;
  height: calc(100vh - 66px);
  min-height: 520px;
  background: #d5dfeb;
}

.map-note {
  position: absolute;
  bottom: 12px;
  left: 50%;
  transform: translateX(-50%);
  padding: 7px 11px;
  border-radius: 20px;
  background: rgba(9, 22, 39, .88);
  color: white;
  font-size: 11px;
  pointer-events: none;
}

@media (max-width: 760px) {
  .layout {
    display: flex;
    flex-direction: column;
  }

  .map-wrap {
    order: 1;
    min-height: 52vh;
  }

  #map {
    height: 52vh;
    min-height: 340px;
  }

  .sidebar {
    order: 2;
    border-right: 0;
  }
}