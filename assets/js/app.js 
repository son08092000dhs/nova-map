(() => {
  "use strict";

  const $ = id => document.getElementById(id);
  const STORAGE_KEY = "nova-map-v5-points";

  const map = L.map("map").setView(
    [21.0285, 105.8542], 12
  );

  const street = L.tileLayer(
    "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
    {
      maxZoom: 19,
      attribution: "© OpenStreetMap"
    }
  );

  const topo = L.tileLayer(
    "https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png",
    {
      maxZoom: 17,
      attribution: "© OpenTopoMap"
    }
  );

  street.addTo(map);

  L.control.layers({
    "Bản đồ đường": street,
    "Địa hình": topo
  }).addTo(map);

  let savedPoints = loadPoints();
  let activeTool = null;
  let workingPoints = [];
  let workingLayer = null;
  let routeLayer = null;
  let searchMarker = null;

  const savedLayer = L.layerGroup().addTo(map);

  function loadPoints() {
    try {
      const data = JSON.parse(
        localStorage.getItem(STORAGE_KEY) || "[]"
      );

      return Array.isArray(data) ? data : [];
    } catch {
      return [];
    }
  }

  function persistPoints() {
    localStorage.setItem(
      STORAGE_KEY,
      JSON.stringify(savedPoints)
    );

    renderSavedPoints();
    updateMetrics();
  }

  function escapeHtml(value) {
    return String(value).replace(
      /[&<>"']/g,
      char => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
      })[char]
    );
  }

  function renderSavedPoints() {
    savedLayer.clearLayers();

    savedPoints.forEach((point, index) => {
      L.marker([point.lat, point.lng])
        .bindPopup(
          `<b>${escapeHtml(point.name || "Điểm " + (index + 1))}</b>`
        )
        .addTo(savedLayer);
    });
  }

  function setStatus(message) {
    $("toolStatus").textContent = message;
  }

  function setTool(tool, message) {
    activeTool = tool;
    workingPoints = [];

    if (workingLayer) {
      map.removeLayer(workingLayer);
      workingLayer = null;
    }

    if (routeLayer) {
      map.removeLayer(routeLayer);
      routeLayer = null;
    }

    setStatus(message);
  }

  function updateMetrics() {
    const center = map.getCenter();

    $("centerValue").textContent =
      `${center.lat.toFixed(4)}, ${center.lng.toFixed(4)}`;

    $("zoomValue").textContent = map.getZoom();

    $("savedCount").textContent = savedPoints.length;
  }

  map.on("moveend zoomend", updateMetrics);

  map.on("click", async event => {
    const point = {
      lat: event.latlng.lat,
      lng: event.latlng.lng
    };

    if (activeTool === "save") {
      savedPoints.push({
        ...point,
        name: `Điểm ${savedPoints.length + 1}`
      });

      persistPoints();

      setStatus("Đã lưu điểm thành công.");

      return;
    }

    if (
      activeTool === "distance" ||
      activeTool === "area"
    ) {
      workingPoints.push(point);

      drawWorkingGeometry();

      const required =
        activeTool === "distance" ? 2 : 3;

      if (workingPoints.length >= required) {
        if (activeTool === "distance") {
          const distance = map.distance(
            [
              workingPoints[0].lat,
              workingPoints[0].lng
            ],
            [
              workingPoints[1].lat,
              workingPoints[1].lng
            ]
          );

          $("measureValue").textContent =
            formatDistance(distance);

          setStatus(
            "Khoảng cách: " + formatDistance(distance)
          );

          activeTool = null;

        } else {
          const area = polygonArea(workingPoints);

          $("measureValue").textContent =
            formatArea(area);

          setStatus(
            "Diện tích ước tính: " + formatArea(area)
          );

          activeTool = null;
        }
      } else {
        setStatus(
          `Đã chọn ${workingPoints.length}/${required} điểm.`
        );
      }

      return;
    }

    if (activeTool === "route") {
      workingPoints.push(point);

      drawWorkingGeometry();

      if (workingPoints.length === 1) {
        setStatus("Chọn điểm đến.");
      }

      if (workingPoints.length === 2) {
        await createRoute(
          workingPoints[0],
          workingPoints[1]
        );
      }
    }
  });

  function drawWorkingGeometry() {
    if (workingLayer) {
      map.removeLayer(workingLayer);
    }

    const points = workingPoints.map(p => [
      p.lat,
      p.lng
    ]);

    if (points.length === 1) {
      workingLayer = L.circleMarker(
        points[0],
        { radius: 7, color: "#ffb347" }
      ).addTo(map);

    } else if (activeTool === "area" && points.length >= 3) {
      workingLayer = L.polygon(points, {
        color: "#ffb347",
        fillOpacity: 0.15
      }).addTo(map);

    } else {
      workingLayer = L.polyline(points, {
        color: "#ffb347",
        weight: 3
      }).addTo(map);
    }
  }

  function polygonArea(points) {
    const R = 6378137;
    let total = 0;

    for (let i = 0; i < points.length; i++) {
      const a = points[i];
      const b = points[(i + 1) % points.length];

      const lon1 = a.lng * Math.PI / 180;
      const lon2 = b.lng * Math.PI / 180;

      const lat1 = a.lat * Math.PI / 180;
      const lat2 = b.lat * Math.PI / 180;

      total +=
        (lon2 - lon1) *
        (2 + Math.sin(lat1) + Math.sin(lat2));
    }

    return Math.abs(total * R * R / 2);
  }

  function formatDistance(meters) {
    return meters >= 1000
      ? (meters / 1000).toFixed(3) + " km"
      : meters.toFixed(1) + " m";
  }

  function formatArea(area) {
    return area >= 1000000
      ? (area / 1000000).toFixed(4) + " km²"
      : area.toFixed(1) + " m²";
  }

  $("savePointBtn").onclick = () => {
    setTool("save", "Chạm bản đồ để lưu điểm.");
  };

  $("distanceBtn").onclick = () => {
    setTool("distance", "Chạm hai điểm để đo khoảng cách.");
  };

  $("areaBtn").onclick = () => {
    setTool("area", "Chạm ít nhất ba điểm để đo diện tích.");
  };

  $("routeBtn").onclick = () => {
    setTool("route", "Chọn điểm xuất phát.");
  };

  $("clearBtn").onclick = () => {
    setTool(null, "Đã xóa thao tác.");
    $("measureValue").textContent = "—";
  };

  $("locateBtn").onclick = () => {
    if (!navigator.geolocation) {
      setStatus("Thiết bị không hỗ trợ GPS.");
      return;
    }

    setStatus("Đang lấy vị trí GPS...");

    navigator.geolocation.getCurrentPosition(
      position => {
        const lat = position.coords.latitude;
        const lng = position.coords.longitude;

        map.setView([lat, lng], 16);

        L.marker([lat, lng])
          .addTo(map)
          .bindPopup("Vị trí thiết bị")
          .openPopup();

        setStatus("Đã xác định vị trí GPS.");
      },
      error => {
        setStatus("Lỗi GPS: " + error.message);
      },
      {
        enableHighAccuracy: true,
        timeout: 12000
      }
    );
  };

  $("searchForm").onsubmit = async event => {
    event.preventDefault();

    const query = $("searchInput").value.trim();

    if (!query) return;

    $("searchStatus").textContent = "Đang tìm kiếm...";

    try {
      const url =
        "https://nominatim.openstreetmap.org/search" +
        "?format=jsonv2&limit=1&q=" +
        encodeURIComponent(query);

      const response = await fetch(url);

      if (!response.ok) {
        throw new Error("Lỗi kết nối dịch vụ tìm kiếm");
      }

      const results = await response.json();

      if (!results.length) {
        $("searchStatus").textContent =
          "Không tìm thấy địa điểm.";

        return;
      }

      const result = results[0];

      const lat = Number(result.lat);
      const lng = Number(result.lon);

      map.setView([lat, lng], 15);

      if (searchMarker) {
        map.removeLayer(searchMarker);
      }

      searchMarker = L.marker([lat, lng])
        .addTo(map)
        .bindPopup(escapeHtml(result.display_name))
        .openPopup();

      $("searchStatus").textContent =
        result.display_name;

    } catch (error) {
      $("searchStatus").textContent =
        "Lỗi: " + error.message;
    }
  };

  async function createRoute(a, b) {
    try {
      const url =
        `https://router.project-osrm.org/route/v1/driving/` +
        `${a.lng},${a.lat};${b.lng},${b.lat}` +
        "?overview=full&geometries=geojson";

      const response = await fetch(url);

      if (!response.ok) {
        throw new Error("Không kết nối được OSRM");
      }

      const data = await response.json();

      if (!data.routes || !data.routes.length) {
        throw new Error("Không tìm thấy tuyến đường");
      }

      const route = data.routes[0];

      if (routeLayer) {
        map.removeLayer(routeLayer);
      }

      routeLayer = L.geoJSON(route.geometry, {
        style: {
          color: "#1e91ff",
          weight: 5
        }
      }).addTo(map);

      map.fitBounds(routeLayer.getBounds());

      setStatus(
        "Tuyến: " +
        formatDistance(route.distance) +
        " · " +
        Math.round(route.duration / 60) +
        " phút (ước tính)"
      );

      activeTool = null;

    } catch (error) {
      setStatus("Lỗi tuyến đường: " + error.message);
      activeTool = null;
    }
  }

  function downloadBlob(blob, filename) {
    const url = URL.createObjectURL(blob);

    const link = document.createElement("a");

    link.href = url;
    link.download = filename;

    document.body.appendChild(link);
    link.click();
    link.remove();

    URL.revokeObjectURL(url);
  }

  $("exportBtn").onclick = () => {
    const features = savedPoints.map(point => ({
      type: "Feature",
      properties: {
        name: point.name
      },
      geometry: {
        type: "Point",
        coordinates: [
          point.lng,
          point.lat
        ]
      }
    }));

    const geojson = {
      type: "FeatureCollection",
      features
    };

    const blob = new Blob(
      [JSON.stringify(geojson, null, 2)],
      { type: "application/geo+json" }
    );

    downloadBlob(blob, "nova-map-points.geojson");
  };

  $("importInput").onchange = async event => {
    const file = event.target.files[0];

    if (!file) return;

    try {
      const data = JSON.parse(await file.text());

      const features =
        data.type === "FeatureCollection"
          ? data.features
          : data.type === "Feature"
            ? [data]
            : [];

      let count = 0;

      features.forEach(feature => {
        const geometry = feature.geometry;

        if (
          geometry &&
          geometry.type === "Point" &&
          Array.isArray(geometry.coordinates)
        ) {
          const [lng, lat] = geometry.coordinates;

          if (
            Number.isFinite(lat) &&
            Number.isFinite(lng)
          ) {
            savedPoints.push({
              lat,
              lng,
              name:
                feature.properties?.name ||
                "Điểm nhập"
            });

            count++;
          }
        }
      });

      persistPoints();

      setStatus("Đã nhập " + count + " điểm.");

    } catch (error) {
      setStatus("Tệp không hợp lệ: " + error.message);
    }

    event.target.value = "";
  };

  $("assistantForm").onsubmit = event => {
    event.preventDefault();

    const question =
      $("assistantInput").value.trim().toLowerCase();

    let answer = "";

    if (question.includes("tọa độ")) {
      const center = map.getCenter();

      answer =
        `Tọa độ tâm bản đồ: ${center.lat.toFixed(6)}, ` +
        `${center.lng.toFixed(6)}`;

    } else if (question.includes("khoảng cách")) {
      answer =
        "Chọn Đo khoảng cách, sau đó chạm hai điểm trên bản đồ.";

    } else if (question.includes("diện tích")) {
      answer =
        "Chọn Đo diện tích, sau đó chạm ít nhất ba điểm.";

    } else if (question.includes("tuyến")) {
      answer =
        "Chọn Tạo tuyến đường, sau đó chọn điểm xuất phát và điểm đến.";

    } else if (question.includes("điểm đã lưu")) {
      answer =
        "Số điểm đã lưu: " + savedPoints.length;

    } else {
      answer =
        "NOVA GEO hỗ trợ hướng dẫn tìm kiếm, GPS, " +
        "đo khoảng cách, diện tích, tuyến đường và GeoJSON. " +
        "Đây là trợ lý theo quy tắc, chưa phải mô hình AI.";
    }

    $("assistantOutput").textContent = answer;
  };

  renderSavedPoints();
  updateMetrics();

  setStatus("NOVA MAP V5 đã khởi tạo.");
})();